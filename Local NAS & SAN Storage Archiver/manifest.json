{
  "id": "nas-backup",
  "name": "Local NAS & SAN Storage Archiver",
  "version": "v3.2.0",
  "category": "Backup & DR",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MongoDB",
    "MySQL",
    "SQLite",
    "All Engines"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/nas-backup",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Local%20NAS%20%26%20SAN%20Storage%20Archiver",
    "openApiSpec": "https://api.cmox.io/openapi/v3/nas-backup.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-nas-backup",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "NAS",
    "Local",
    "On-Prem",
    "Offline Backup"
  ],
  "features": [
    "100% On-Premise data path — zero external cloud telemetry",
    "Direct SMB, NFSv4, and local UNC file path support",
    "Automatic digital signature and SHA-256 integrity checks",
    "Automated grandfather-father-son (GFS) rotation retention"
  ],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "\\\\192.168.1.100\\Backups\\CMOX",
    "syncIntervalSec": 3600,
    "logLevel": "info",
    "param1Label": "Retention Snapshots Count",
    "param1Value": "30",
    "param2Label": "Compression Algorithm",
    "param2Value": "zstd-level-19"
  }
}