{
  "id": "incremental-backup",
  "name": "Block-Level Incremental Snapshot Engine",
  "version": "v2.0.5",
  "category": "Backup & DR",
  "price": "$9/mo",
  "author": "CDUS Tech Core",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Incremental",
    "Storage",
    "Fast",
    "WAL"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "syncIntervalSec": 900,
    "logLevel": "info",
    "param1Label": "Full Backup Frequency",
    "param1Value": "weekly",
    "param2Label": "Checksum Verification",
    "param2Value": "sha256"
  }
}