{
  "id": "incremental-backup",
  "name": "Block-Level Incremental Snapshot Engine",
  "version": "v2.0.5",
  "category": "Backup & DR",
  "price": "$9/mo",
  "author": "CDUS Tech Core",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/incremental-backup",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Block-Level%20Incremental%20Snapshot%20Engine",
    "openApiSpec": "https://api.cmox.io/openapi/v3/incremental-backup.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-incremental-backup",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Incremental",
    "Storage",
    "Fast",
    "WAL"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "syncIntervalSec": 900,
    "logLevel": "info",
    "param1Label": "Full Backup Frequency",
    "param1Value": "weekly",
    "param2Label": "Checksum Verification",
    "param2Value": "sha256"
  }
}