{
  "id": "azure-blob-vault",
  "name": "Azure Blob WORM Storage Vault",
  "version": "v1.9.0",
  "category": "Backup & DR",
  "price": "$9/mo",
  "author": "Microsoft Partner",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
