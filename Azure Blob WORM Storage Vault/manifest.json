  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/azure-blob-vault",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Azure%20Blob%20WORM%20Storage%20Vault",
    "openApiSpec": "https://api.cmox.io/openapi/v3/azure-blob-vault.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-azure-blob-vault",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Azure",
    "Blob",
    "WORM",
    "Compliance"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://cmoxbackup.blob.core.windows.net",
    "logLevel": "info",
    "param1Label": "Container Name",
    "param1Value": "immutable-vault",
    "param2Label": "Legal Hold Enabled",
    "param2Value": "true"
  }
}