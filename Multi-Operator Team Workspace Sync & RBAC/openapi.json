{
  "openapi": "3.0.3",
  "info": {
    "title": "Multi-Operator Team Workspace Sync & RBAC REST API",
    "description": "Collaborate with developers and DBAs with real-time cursor presence, shared queries, and fine-grained permissions.",
    "version": "2.5.0"
  },
  "servers": [
    {
      "url": "http://localhost:7890",
      "description": "Universal Bridge Server"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "summary": "Ingest transactional event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "example": "insert"
                  },
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event ingested successfully"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Get live metrics and health report",
        "responses": {
          "200": {
            "description": "Health report object"
          }
        }
      }
    }
  }
}