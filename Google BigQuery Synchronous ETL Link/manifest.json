{
  "id": "bigquery-etl-link",
  "name": "Google BigQuery Synchronous ETL Link",
  "version": "v2.8.0",
  "category": "Analytics & OLAP",
  "price": "$25/mo",
  "author": "Cloud Infrastructure",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "BigQuery",
    "GCP",
    "Data Warehouse",
    "ETL"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "apiKeyPlaceholder": "gcp_service_account_json_key",
    "logLevel": "info",
    "param1Label": "GCP Project ID",
    "param1Value": "corp-production-ai",
    "param2Label": "Dataset ID",
    "param2Value": "cmox_analytics"
  }
}