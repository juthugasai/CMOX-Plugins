{
  "id": "typescript-zod-exporter",
  "name": "TypeScript Interface & Zod Schema Exporter",
  "version": "v4.0.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/typescript-zod-exporter",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/TypeScript%20Interface%20%26%20Zod%20Schema%20Exporter",
    "openApiSpec": "https://api.cmox.io/openapi/v3/typescript-zod-exporter.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-typescript-zod-exporter",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "TypeScript",
    "Zod",
    "Types",
    "Full-Stack"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Generate Zod Schemas",
    "param1Value": "true",
    "param2Label": "Export File Name",
    "param2Value": "database.types.ts"
  }
}