{
  "id": "active-directory-ldap",
  "name": "Active Directory & LDAP Single Sign-On",
  "version": "v3.0.0",
  "category": "Security & IAM",
  "price": "$20/mo",
  "author": "Enterprise Auth",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/active-directory-ldap",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Active%20Directory%20%26%20LDAP%20Single%20Sign-On",
    "openApiSpec": "https://api.cmox.io/openapi/v3/active-directory-ldap.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-active-directory-ldap",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "LDAP",
    "ActiveDirectory",
    "SSO",
    "SAML",
    "Okta"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "ldaps://ad.corp.internal:636",
    "logLevel": "info",
    "param1Label": "Base DN",
    "param1Value": "dc=corp,dc=internal",
    "param2Label": "Group Filter",
    "param2Value": "(&(objectClass=group)(cn=DBA_*))"
  }
}