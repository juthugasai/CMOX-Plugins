{
  "id": "active-directory-ldap",
  "name": "Active Directory & LDAP Single Sign-On",
  "version": "v3.0.0",
  "category": "Security & IAM",
  "price": "$20/mo",
  "author": "Enterprise Auth",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "LDAP",
    "ActiveDirectory",
    "SSO",
    "SAML",
    "Okta"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "ldaps://ad.corp.internal:636",
    "logLevel": "info",
    "param1Label": "Base DN",
    "param1Value": "dc=corp,dc=internal",
    "param2Label": "Group Filter",
    "param2Value": "(&(objectClass=group)(cn=DBA_*))"
  }
}