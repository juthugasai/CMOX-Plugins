{
  "id": "swagger-openapi-ui",
  "name": "OpenAPI 3.0 & Interactive Swagger UI Generator",
  "version": "v2.3.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/swagger-openapi-ui",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/OpenAPI%203.0%20%26%20Interactive%20Swagger%20UI%20Generator",
    "openApiSpec": "https://api.cmox.io/openapi/v3/swagger-openapi-ui.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-swagger-openapi-ui",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "OpenAPI",
    "Swagger",
    "Docs",
    "Postman"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "/api/docs",
    "logLevel": "info",
    "param1Label": "API Title",
    "param1Value": "CMOX Database API",
    "param2Label": "API Version",
    "param2Value": "v1.0.0"
  }
}