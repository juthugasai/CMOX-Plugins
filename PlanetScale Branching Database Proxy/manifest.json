{
  "id": "planetscale-proxy",
  "name": "PlanetScale Branching Database Proxy",
  "version": "v2.0.0",
  "category": "Cloud & Edge",
  "price": "$16/mo",
  "author": "Vitess Community",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/planetscale-proxy",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/PlanetScale%20Branching%20Database%20Proxy",
    "openApiSpec": "https://api.cmox.io/openapi/v3/planetscale-proxy.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-planetscale-proxy",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "PlanetScale",
    "Vitess",
    "Branching",
    "MySQL"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://api.planetscale.com/v1",
    "apiKeyPlaceholder": "pscale_service_token",
    "logLevel": "info",
    "param1Label": "Organization",
    "param1Value": "my-org",
    "param2Label": "Database Name",
    "param2Value": "main-production"
  }
}