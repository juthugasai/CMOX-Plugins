{
  "id": "postman-newman-ci",
  "name": "Postman Collection & Newman CI/CD Runner",
  "version": "v1.7.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "QA Tooling",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/postman-newman-ci",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Postman%20Collection%20%26%20Newman%20CI_CD%20Runner",
    "openApiSpec": "https://api.cmox.io/openapi/v3/postman-newman-ci.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-postman-newman-ci",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Postman",
    "Newman",
    "CI/CD",
    "Testing"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Export Format",
    "param1Value": "Postman-Collection-v2.1",
    "param2Label": "Auto-Inject JWT Auth",
    "param2Value": "true"
  }
}