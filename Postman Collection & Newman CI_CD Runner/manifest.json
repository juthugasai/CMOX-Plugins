{
  "id": "postman-newman-ci",
  "name": "Postman Collection & Newman CI/CD Runner",
  "version": "v1.7.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "QA Tooling",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Postman",
    "Newman",
    "CI/CD",
    "Testing"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Export Format",
    "param1Value": "Postman-Collection-v2.1",
    "param2Label": "Auto-Inject JWT Auth",
    "param2Value": "true"
  }
}