{
  "id": "gcs-archiver",
  "name": "Google Cloud Storage (GCS) Nearline Archiver",
  "version": "v2.1.0",
  "category": "Backup & DR",
  "price": "$9/mo",
  "author": "Cloud Infrastructure",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
