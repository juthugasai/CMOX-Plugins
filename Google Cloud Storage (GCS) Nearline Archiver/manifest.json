    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/gcs-archiver",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Google%20Cloud%20Storage%20(GCS)%20Nearline%20Archiver",
    "openApiSpec": "https://api.cmox.io/openapi/v3/gcs-archiver.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-gcs-archiver",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "GCS",
    "GCP",
    "Cloud Storage",
    "Nearline"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://storage.googleapis.com",
    "logLevel": "info",
    "param1Label": "Bucket Name",
    "param1Value": "cmox-gcs-archive",
    "param2Label": "Storage Class",
    "param2Value": "NEARLINE"
  }
