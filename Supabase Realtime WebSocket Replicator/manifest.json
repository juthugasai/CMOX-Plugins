{
  "id": "supabase-replicator",
  "name": "Supabase Realtime WebSocket Replicator",
  "version": "v3.1.0",
  "category": "Cloud & Edge",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/supabase-replicator",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Supabase%20Realtime%20WebSocket%20Replicator",
    "openApiSpec": "https://api.cmox.io/openapi/v3/supabase-replicator.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-supabase-replicator",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Supabase",
    "Realtime",
    "Postgres",
    "BaaS"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://your-project.supabase.co",
    "apiKeyPlaceholder": "supabase_service_role_key",
    "logLevel": "info",
    "param1Label": "Schema Name",
    "param1Value": "public",
    "param2Label": "Enable Realtime Broadcasts",
    "param2Value": "true"
  }
}