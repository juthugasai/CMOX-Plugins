{
  "id": "rest-generator",
  "name": "REST API Auto-Generator & Swagger",
  "version": "v3.0.0",
  "category": "Connectors",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/rest-generator",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/REST%20API%20Auto-Generator%20%26%20Swagger",
    "openApiSpec": "https://api.cmox.io/openapi/v3/rest-generator.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-rest-generator",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "REST",
    "CRUD",
    "OpenAPI",
    "Swagger",
    "HTTP"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "/api/v1",
    "logLevel": "info",
    "param1Label": "Default Page Size",
    "param1Value": "50",
    "param2Label": "Max Page Size Limit",
    "param2Value": "250"
  }
}