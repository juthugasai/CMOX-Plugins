  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/deno-deploy-kv-sync",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Deno%20Deploy%20Edge%20KV%20Database%20Sync",
    "openApiSpec": "https://api.cmox.io/openapi/v3/deno-deploy-kv-sync.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-deno-deploy-kv-sync",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Deno",
    "DenoKV",
    "Edge",
    "TypeScript"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "apiKeyPlaceholder": "deno_deploy_access_token",
    "logLevel": "info",
    "param1Label": "Project ID",
    "param1Value": "my-deno-project",
    "param2Label": "Root Key Prefix",
    "param2Value": "cmox_master"
  }
