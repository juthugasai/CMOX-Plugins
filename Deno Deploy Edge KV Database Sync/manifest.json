{
  "id": "deno-deploy-kv-sync",
  "name": "Deno Deploy Edge KV Database Sync",
  "version": "v1.4.0",
  "category": "Cloud & Edge",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
