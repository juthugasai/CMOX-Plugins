{
  "id": "notion-bridge",
  "name": "Notion Database 2-Way Sync Bridge",
  "version": "v1.9.4",
  "category": "Connectors",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": false,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/notion-bridge",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Notion%20Database%202-Way%20Sync%20Bridge",
    "openApiSpec": "https://api.cmox.io/openapi/v3/notion-bridge.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-notion-bridge",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Notion",
    "Productivity",
    "Sync",
    "No-Code"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "apiKeyPlaceholder": "secret_notion_api_token",
    "syncIntervalSec": 60,
    "logLevel": "warn",
    "param1Label": "Notion Database ID",
    "param1Value": "8f7e2d9a1b4c...",
    "param2Label": "Conflict Resolution",
    "param2Value": "cmox-wins"
  }
}