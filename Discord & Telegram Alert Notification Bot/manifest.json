{
  "id": "telegram-discord-alerts",
  "name": "Discord & Telegram Alert Notification Bot",
  "version": "v2.1.0",
  "category": "Monitoring & Ops",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/telegram-discord-alerts",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Discord%20%26%20Telegram%20Alert%20Notification%20Bot",
    "openApiSpec": "https://api.cmox.io/openapi/v3/telegram-discord-alerts.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-telegram-discord-alerts",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Telegram",
    "Discord",
    "Bot",
    "Alerts"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://discord.com/api/webhooks/...",
    "logLevel": "info",
    "param1Label": "Alert Severity Filter",
    "param1Value": "WARN,ERROR,CRITICAL",
    "param2Label": "Include Query Snippet",
    "param2Value": "true"
  }
}