{
  "id": "telegram-discord-alerts",
  "name": "Discord & Telegram Alert Notification Bot",
  "version": "v2.1.0",
  "category": "Monitoring & Ops",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Telegram",
    "Discord",
    "Bot",
    "Alerts"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://discord.com/api/webhooks/...",
    "logLevel": "info",
    "param1Label": "Alert Severity Filter",
    "param1Value": "WARN,ERROR,CRITICAL",
    "param2Label": "Include Query Snippet",
    "param2Value": "true"
  }
}