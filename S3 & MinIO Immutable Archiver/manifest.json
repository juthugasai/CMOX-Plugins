  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/s3-snapshot-archiver",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/S3%20%26%20MinIO%20Immutable%20Archiver",
    "openApiSpec": "https://api.cmox.io/openapi/v3/s3-snapshot-archiver.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-s3-snapshot-archiver",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "S3",
    "MinIO",
    "Object Storage",
    "WORM"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "https://s3.us-east-1.amazonaws.com",
    "logLevel": "info",
    "param1Label": "S3 Bucket Name",
    "param1Value": "company-cmox-backups",
    "param2Label": "Storage Class",
    "param2Value": "GLACIER_IR"
