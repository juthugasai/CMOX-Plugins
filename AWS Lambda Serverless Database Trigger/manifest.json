{
  "id": "lambda-serverless-trigger",
  "name": "AWS Lambda Serverless Database Trigger",
  "version": "v2.7.0",
  "category": "Cloud & Edge",
  "price": "$12/mo",
  "author": "AWS Solutions Partner",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/lambda-serverless-trigger",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/AWS%20Lambda%20Serverless%20Database%20Trigger",
    "openApiSpec": "https://api.cmox.io/openapi/v3/lambda-serverless-trigger.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-lambda-serverless-trigger",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "AWS",
    "Lambda",
    "Serverless",
    "Events"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "arn:aws:lambda:us-east-1:123456789:function:ProcessDbEvent",
    "logLevel": "info",
    "param1Label": "Invocation Type",
    "param1Value": "Event (Async)",
    "param2Label": "Max Batch Size",
    "param2Value": "100"
  }
}