{
  "id": "mysql-live-bridge",
  "name": "MySQL / MariaDB Live Migration Bridge",
  "version": "v2.4.0",
  "category": "Import/Export",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/mysql-live-bridge",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/MySQL%20_%20MariaDB%20Live%20Migration%20Bridge",
    "openApiSpec": "https://api.cmox.io/openapi/v3/mysql-live-bridge.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-mysql-live-bridge",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "MySQL",
    "MariaDB",
    "Migration",
    "Binlog"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "mysql://root:password@localhost:3306/legacy_db",
    "logLevel": "info",
    "param1Label": "Server ID",
    "param1Value": "1001",
    "param2Label": "SSL Mode",
    "param2Value": "PREFERRED"
  }
}