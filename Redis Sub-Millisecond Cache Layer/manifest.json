{
  "id": "redis-cache",
  "name": "Redis Sub-Millisecond Cache Layer",
  "version": "v4.0.1",
  "category": "Connectors",
  "price": "$12/mo",
  "author": "CDUS Tech Core",
  "license": "Commercial / Proprietary",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/redis-cache",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Redis%20Sub-Millisecond%20Cache%20Layer",
    "openApiSpec": "https://api.cmox.io/openapi/v3/redis-cache.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-redis-cache",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Redis",
    "Caching",
    "In-Memory",
    "Performance",
    "Speed"
  ],
  "features": [
    "Sub-0.5ms cached query reads directly from RAM",
    "Intelligent mutation-aware cache tag invalidation",
    "Redis Cluster & Redis Sentinel high-availability failover",
    "Configurable LRU/LFU cache memory eviction policies"
  ],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "redis://127.0.0.1:6379",
    "cacheTtlSec": 300,
    "logLevel": "info",
    "param1Label": "Max Memory Policy",
    "param1Value": "allkeys-lru",
    "param2Label": "Key Prefix",
    "param2Value": "cmox:cache:"
  }
}