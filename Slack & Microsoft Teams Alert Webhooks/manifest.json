{
  "id": "slack-teams-webhooks",
  "name": "Slack & Microsoft Teams Alert Webhooks",
  "version": "v3.1.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
