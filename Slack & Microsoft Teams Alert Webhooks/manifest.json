  "tags": [
    "Slack",
    "Teams",
    "Webhooks",
    "ChatOps"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://hooks.slack.com/services/...",
    "logLevel": "info",
    "param1Label": "Target Channel",
    "param1Value": "#database-alerts",
    "param2Label": "Notify on Schema Migrations",
    "param2Value": "true"
  }
