{
  "id": "slack-teams-webhooks",
  "name": "Slack & Microsoft Teams Alert Webhooks",
  "version": "v3.1.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Slack",
    "Teams",
    "Webhooks",
    "ChatOps"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://hooks.slack.com/services/...",
    "logLevel": "info",
    "param1Label": "Target Channel",
    "param1Value": "#database-alerts",
    "param2Label": "Notify on Schema Migrations",
    "param2Value": "true"
  }
}