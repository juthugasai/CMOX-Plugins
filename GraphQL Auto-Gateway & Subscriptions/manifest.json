{
  "id": "graphql-gateway",
  "name": "GraphQL Auto-Gateway & Subscriptions",
  "version": "v2.5.0",
  "category": "Connectors",
  "price": "$19/mo",
  "author": "CDUS Tech Core",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MongoDB",
    "MySQL",
    "SQLite"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/graphql-gateway",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/GraphQL%20Auto-Gateway%20%26%20Subscriptions",
    "openApiSpec": "https://api.cmox.io/openapi/v3/graphql-gateway.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-graphql-gateway",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "GraphQL",
    "API",
    "Realtime",
    "Subscriptions",
    "Apollo"
  ],
  "features": [
    "Zero-config auto-generation of GraphQL types, queries & mutations",
    "Real-time WebSocket subscriptions on table mutations",
    "Query complexity analysis and depth limiting",
    "Interactive embedded GraphQL Playground UI"
  ],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "http://localhost:4000/graphql",
    "logLevel": "info",
    "param1Label": "Playground UI Enabled",
    "param1Value": "true",
    "param2Label": "Query Complexity Limit",
    "param2Value": "1000"
  }
}