{
  "id": "rls-policy-manager",
  "name": "Row-Level Security (RLS) Policy Manager",
  "version": "v2.6.0",
  "category": "Security & IAM",
  "price": "$15/mo",
  "author": "CDUS Tech Core",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "RLS",
    "Multi-Tenant",
    "Policies",
    "RBAC"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Default Policy Mode",
    "param1Value": "deny-by-default",
    "param2Label": "Tenant Header Key",
    "param2Value": "X-Tenant-ID"
  }
}