  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/flink-stream-processor",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Apache%20Flink%20Real-Time%20Stateful%20Stream%20Processor",
    "openApiSpec": "https://api.cmox.io/openapi/v3/flink-stream-processor.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-flink-stream-processor",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Flink",
    "Streaming",
    "Stateful",
    "Big Data"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "http://flink-jobmanager:8081",
    "logLevel": "info",
