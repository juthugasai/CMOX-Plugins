{
  "id": "json-validator",
  "name": "JSON / BSON Document Schema Validator",
  "version": "v1.9.0",
  "category": "Import/Export",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/json-validator",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/JSON%20_%20BSON%20Document%20Schema%20Validator",
    "openApiSpec": "https://api.cmox.io/openapi/v3/json-validator.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-json-validator",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "JSON",
    "Schema",
    "Validation",
    "JSONB"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Validation Draft Standard",
    "param1Value": "draft-07",
    "param2Label": "Coerce Missing Types",
    "param2Value": "false"
  }
}