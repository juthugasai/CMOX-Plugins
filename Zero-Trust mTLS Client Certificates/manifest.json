{
  "id": "mtls-certificates",
  "name": "Zero-Trust mTLS Client Certificates",
  "version": "v2.0.0",
  "category": "Security & IAM",
  "price": "$19/mo",
  "author": "Security Labs",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "mTLS",
    "Certificates",
    "Zero-Trust",
    "x509"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "logLevel": "warn",
    "param1Label": "CA Certificate Path",
    "param1Value": "/etc/ssl/cmox/root-ca.crt",
    "param2Label": "Min TLS Version",
    "param2Value": "TLSv1.3"
  }
}