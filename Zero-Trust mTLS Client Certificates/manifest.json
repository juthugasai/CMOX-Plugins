{
  "id": "mtls-certificates",
  "name": "Zero-Trust mTLS Client Certificates",
  "version": "v2.0.0",
  "category": "Security & IAM",
  "price": "$19/mo",
  "author": "Security Labs",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/mtls-certificates",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Zero-Trust%20mTLS%20Client%20Certificates",
    "openApiSpec": "https://api.cmox.io/openapi/v3/mtls-certificates.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-mtls-certificates",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "mTLS",
    "Certificates",
    "Zero-Trust",
    "x509"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "logLevel": "warn",
    "param1Label": "CA Certificate Path",
    "param1Value": "/etc/ssl/cmox/root-ca.crt",
    "param2Label": "Min TLS Version",
    "param2Value": "TLSv1.3"
  }
}