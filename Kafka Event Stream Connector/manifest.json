{
  "id": "kafka-connector",
  "name": "Kafka Event Stream Connector",
  "version": "v2.8.0",
  "category": "Connectors",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "Apache-2.0",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MongoDB",
    "MySQL",
    "SQLite"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/kafka-connector",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Kafka%20Event%20Stream%20Connector",
    "openApiSpec": "https://api.cmox.io/openapi/v3/kafka-connector.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-kafka-connector",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Kafka",
    "Streaming",
    "CDC",
    "Message Queue",
    "Events"
  ],
  "features": [
    "Sub-millisecond write-to-topic latency",
    "Confluent Schema Registry Avro & Protobuf integration",
    "Automatic partition key hashing on primary keys",
    "Dead-letter queue (DLQ) retry orchestration",
    "SASL/SSL, Kerberos, and mTLS security handshakes"
  ],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "kafka://127.0.0.1:9092",
    "syncIntervalSec": 1,
    "logLevel": "info",
    "param1Label": "Target Topic Prefix",
    "param1Value": "cmox.events.",
    "param2Label": "Compression Codec",
    "param2Value": "snappy"
  }
}