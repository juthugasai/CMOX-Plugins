{
  "id": "ip-geofencing",
  "name": "IP Geofencing & CIDR Whitelist Guard",
  "version": "v2.0.1",
  "category": "Security & IAM",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/ip-geofencing",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/IP%20Geofencing%20%26%20CIDR%20Whitelist%20Guard",
    "openApiSpec": "https://api.cmox.io/openapi/v3/ip-geofencing.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-ip-geofencing",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Firewall",
    "IP",
    "Geofence",
    "Security"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "logLevel": "warn",
    "param1Label": "Allowed Countries",
    "param1Value": "US, CA, GB, DE, JP, IN",
    "param2Label": "Allowed CIDRs",
    "param2Value": "10.0.0.0/8, 192.168.0.0/16"
  }
}