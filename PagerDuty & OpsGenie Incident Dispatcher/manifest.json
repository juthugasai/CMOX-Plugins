{
  "id": "pagerduty-dispatcher",
  "name": "PagerDuty & OpsGenie Incident Dispatcher",
  "version": "v1.5.0",
  "category": "Monitoring & Ops",
  "price": "$8/mo",
  "author": "Incident Labs",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/pagerduty-dispatcher",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/PagerDuty%20%26%20OpsGenie%20Incident%20Dispatcher",
    "openApiSpec": "https://api.cmox.io/openapi/v3/pagerduty-dispatcher.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-pagerduty-dispatcher",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "PagerDuty",
    "Alerts",
    "On-Call",
    "Incident"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "apiKeyPlaceholder": "pd_integration_routing_key",
    "logLevel": "warn",
    "param1Label": "Urgency Level",
    "param1Value": "high",
    "param2Label": "Auto-Resolve on Recovery",
    "param2Value": "true"
  }
}