{
  "id": "duckdb-engine",
  "name": "DuckDB In-Memory OLAP Calculation Engine",
  "version": "v2.5.0",
  "category": "Analytics & OLAP",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/duckdb-engine",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/DuckDB%20In-Memory%20OLAP%20Calculation%20Engine",
    "openApiSpec": "https://api.cmox.io/openapi/v3/duckdb-engine.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-duckdb-engine",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "DuckDB",
    "In-Memory",
    "Fast",
    "OLAP",
    "Pandas"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Threads Count",
    "param1Value": "8",
    "param2Label": "Memory Limit MB",
    "param2Value": "4096"
  }
}