{
  "id": "elasticsearch-sync",
  "name": "Elasticsearch Full-Text Search Sync",
  "version": "v2.3.0",
  "category": "Connectors",
  "price": "$14/mo",
  "author": "Elastic Partner",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MongoDB",
    "MySQL"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/elasticsearch-sync",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Elasticsearch%20Full-Text%20Search%20Sync",
    "openApiSpec": "https://api.cmox.io/openapi/v3/elasticsearch-sync.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-elasticsearch-sync",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Elasticsearch",
    "Search",
    "NLP",
    "OpenSearch",
    "Lucene"
  ],
  "features": [
    "Instant fuzzy search and typo tolerance across database records",
    "Auto-generated phonetic, soundex, and n-gram analyzers",
    "Bulk batch indexing pipeline supporting 50k docs/sec",
    "Compatible with Elasticsearch 8.x and OpenSearch 2.x"
  ],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "http://localhost:9200",
    "syncIntervalSec": 10,
    "logLevel": "info",
    "param1Label": "Index Prefix",
    "param1Value": "cmox_idx_",
    "param2Label": "Shards / Replicas",
    "param2Value": "3 / 1"
  }
}