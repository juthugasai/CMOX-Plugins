{
  "id": "health-sentinel",
  "name": "Database Health & Resource Sentinel",
  "version": "v3.9.0",
  "category": "Monitoring & Ops",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/health-sentinel",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Database%20Health%20%26%20Resource%20Sentinel",
    "openApiSpec": "https://api.cmox.io/openapi/v3/health-sentinel.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-health-sentinel",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Health",
    "CPU",
    "RAM",
    "Telemetry"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "syncIntervalSec": 2,
    "logLevel": "info",
    "param1Label": "Warning CPU %",
    "param1Value": "85",
    "param2Label": "Max Active Connections",
    "param2Value": "500"
  }
}