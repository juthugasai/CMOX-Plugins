{
  "id": "clickhouse-driver",
  "name": "ClickHouse High-Throughput Analytics Driver",
  "version": "v3.0.0",
  "category": "Analytics & OLAP",
  "price": "$24/mo",
  "author": "ClickHouse Partner",
  "license": "Apache-2.0",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/clickhouse-driver",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/ClickHouse%20High-Throughput%20Analytics%20Driver",
    "openApiSpec": "https://api.cmox.io/openapi/v3/clickhouse-driver.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-clickhouse-driver",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "ClickHouse",
    "Columnar",
    "OLAP",
    "Big Data",
    "Analytics"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "clickhouse://default:password@localhost:9000/analytics",
    "logLevel": "info",
    "param1Label": "Target MergeTree Table",
    "param1Value": "events_columnar",
    "param2Label": "Batch Block Size",
    "param2Value": "100000"
  }
}