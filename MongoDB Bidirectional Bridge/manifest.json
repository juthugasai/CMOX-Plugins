{
  "id": "mongodb-bridge",
  "name": "MongoDB Bidirectional Bridge",
  "version": "v3.1.2",
  "category": "Connectors",
  "price": "Free",
  "author": "Community Verified",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "MongoDB",
    "PostgreSQL",
    "SQLite"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/mongodb-bridge",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/MongoDB%20Bidirectional%20Bridge",
    "openApiSpec": "https://api.cmox.io/openapi/v3/mongodb-bridge.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-mongodb-bridge",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "MongoDB",
    "NoSQL",
    "Sync",
    "Document DB"
  ],
  "features": [
    "Two-way real-time replication via MongoDB Change Streams",
    "Automatic BSON ObjectId to UUID translation",
    "Nested JSON column schema inference",
    "Configurable write concerns (majority, w:1, w:0)"
  ],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "endpoint": "mongodb://localhost:27017/cmox_sync",
    "syncIntervalSec": 5,
    "logLevel": "info",
    "param1Label": "Target Database",
    "param1Value": "production_bridge",
    "param2Label": "Write Concern",
    "param2Value": "majority"
  }
}