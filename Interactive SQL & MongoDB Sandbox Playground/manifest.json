{
  "id": "sql-playground-sandbox",
  "name": "Interactive SQL & MongoDB Sandbox Playground",
  "version": "v2.8.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/sql-playground-sandbox",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Interactive%20SQL%20%26%20MongoDB%20Sandbox%20Playground",
    "openApiSpec": "https://api.cmox.io/openapi/v3/sql-playground-sandbox.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-sql-playground-sandbox",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Playground",
    "SQL",
    "Testing",
    "Sandbox"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Isolation Engine",
    "param1Value": "in-memory-wasm",
    "param2Label": "Auto-Rollback on Error",
    "param2Value": "true"
  }
}