  "tags": [
    "SQLite",
    "Portable",
    "Offline",
    "Edge DB"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Journal Mode",
