{
  "id": "spark-batch-runner",
  "name": "Apache Spark Distributed Compute Batch Runner",
  "version": "v3.1.0",
  "category": "Analytics & OLAP",
  "price": "$35/mo",
  "author": "Enterprise BigData",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Spark",
    "PySpark",
    "Distributed",
    "Hadoop"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "spark://spark-master:7077",
    "logLevel": "info",
    "param1Label": "Executor Cores",
    "param1Value": "4",
    "param2Label": "Executor Memory",
    "param2Value": "8g"
  }
}