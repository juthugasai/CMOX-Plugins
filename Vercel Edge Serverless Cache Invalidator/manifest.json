  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "https://my-app.vercel.app/api/revalidate",
    "apiKeyPlaceholder": "vercel_revalidate_secret",
    "logLevel": "info",
    "param1Label": "Tag Map Strategy",
    "param1Value": "table-name-tag",
    "param2Label": "Throttle Delay (ms)",
    "param2Value": "500"
