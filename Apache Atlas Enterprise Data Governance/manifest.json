{
  "id": "apache-atlas-governance",
  "name": "Apache Atlas Enterprise Data Governance",
  "version": "v2.6.0",
  "category": "Data Governance",
  "price": "$25/mo",
  "author": "Enterprise Governance",
  "license": "Apache-2.0",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
