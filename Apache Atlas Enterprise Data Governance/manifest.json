  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "http://atlas-server:21000",
    "logLevel": "info",
    "param1Label": "Cluster Name",
    "param1Value": "cmox_primary_cluster",
    "param2Label": "Auto-Tag Classification",
    "param2Value": "PII_RESTRICTED"
