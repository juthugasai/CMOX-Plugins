{
  "id": "doris-analytics-warehouse",
  "name": "Apache Doris Real-time Fast Analytics Warehouse",
  "version": "v1.6.0",
  "category": "Analytics & OLAP",
  "price": "Free",
  "author": "Community",
  "license": "Apache-2.0",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Doris",
    "MPP",
    "Warehouse",
    "OLAP"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "http://doris-fe:8030",
    "logLevel": "info",
    "param1Label": "Cluster FE Host",
    "param1Value": "127.0.0.1:9030",
    "param2Label": "Replication Factor",
    "param2Value": "3"
  }
}