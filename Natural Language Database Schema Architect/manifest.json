{
  "id": "schema-architect-ai",
  "name": "Natural Language Database Schema Architect",
  "version": "v2.9.0",
  "category": "AI & Automation",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/schema-architect-ai",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Natural%20Language%20Database%20Schema%20Architect",
    "openApiSpec": "https://api.cmox.io/openapi/v3/schema-architect-ai.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-schema-architect-ai",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Schema",
    "AI",
    "Design",
    "Architecture"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Naming Convention",
    "param1Value": "snake_case_plural",
    "param2Label": "Enforce Soft Deletes",
    "param2Value": "true"
  }
}