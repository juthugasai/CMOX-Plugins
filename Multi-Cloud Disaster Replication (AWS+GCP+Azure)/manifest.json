  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/multi-cloud-dr",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Multi-Cloud%20Disaster%20Replication%20(AWS%2BGCP%2BAzure)",
    "openApiSpec": "https://api.cmox.io/openapi/v3/multi-cloud-dr.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-multi-cloud-dr",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Multi-Cloud",
    "Geo",
    "Redundancy",
    "High Availability"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Primary Mirror Target",
    "param1Value": "AWS-us-east-1",
    "param2Label": "Secondary Mirror Target",
    "param2Value": "GCP-europe-west3"
  }
}