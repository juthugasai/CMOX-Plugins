{
  "id": "sqli-firewall",
  "name": "SQL Injection Firewall & WAF Engine",
  "version": "v4.2.0",
  "category": "Security & IAM",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/sqli-firewall",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/SQL%20Injection%20Firewall%20%26%20WAF%20Engine",
    "openApiSpec": "https://api.cmox.io/openapi/v3/sqli-firewall.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-sqli-firewall",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "WAF",
    "SQLi",
    "Defense",
    "Firewall"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "warn",
    "param1Label": "Inspection Mode",
    "param1Value": "block-and-alert",
    "param2Label": "Max Allowed Stacked Queries",
    "param2Value": "1"
  }
}