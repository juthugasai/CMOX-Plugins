{
  "id": "prometheus-exporter",
  "name": "Prometheus & OpenTelemetry Exporter",
  "version": "v2.2.0",
  "category": "Monitoring & Ops",
  "price": "Free",
  "author": "Community",
  "license": "Apache-2.0",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/prometheus-exporter",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Prometheus%20%26%20OpenTelemetry%20Exporter",
    "openApiSpec": "https://api.cmox.io/openapi/v3/prometheus-exporter.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-prometheus-exporter",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Prometheus",
    "OpenTelemetry",
    "Grafana",
    "Metrics"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "http://0.0.0.0:9187/metrics",
    "logLevel": "info",
    "param1Label": "Scrape Interval (s)",
    "param1Value": "15",
    "param2Label": "Include Per-Table Stats",
    "param2Value": "true"
  }
}