{
  "id": "prometheus-exporter",
  "name": "Prometheus & OpenTelemetry Exporter",
  "version": "v2.2.0",
  "category": "Monitoring & Ops",
  "price": "Free",
  "author": "Community",
  "license": "Apache-2.0",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "Prometheus",
    "OpenTelemetry",
    "Grafana",
    "Metrics"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "http://0.0.0.0:9187/metrics",
    "logLevel": "info",
    "param1Label": "Scrape Interval (s)",
    "param1Value": "15",
    "param2Label": "Include Per-Table Stats",
    "param2Value": "true"
  }
}