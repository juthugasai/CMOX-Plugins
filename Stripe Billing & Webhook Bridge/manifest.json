{
  "id": "stripe-webhook-bridge",
  "name": "Stripe Billing & Webhook Bridge",
  "version": "v3.4.0",
  "category": "Connectors",
  "price": "$18/mo",
  "author": "CDUS Tech Core",
  "license": "Commercial",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/stripe-webhook-bridge",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/Stripe%20Billing%20%26%20Webhook%20Bridge",
    "openApiSpec": "https://api.cmox.io/openapi/v3/stripe-webhook-bridge.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-stripe-webhook-bridge",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "Stripe",
    "Fintech",
    "Payments",
    "Billing"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "apiKeyPlaceholder": "sk_live_stripe_secret_key",
    "logLevel": "info",
    "param1Label": "Webhook Signing Secret",
    "param1Value": "whsec_...",
    "param2Label": "Sync Inactive Subscriptions",
    "param2Value": "true"
  }
}