{
  "id": "rabbitmq-exchange",
  "name": "RabbitMQ AMQP Event Exchange",
  "version": "v1.8.2",
  "category": "Connectors",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "cli": "cli.sh",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "tags": [
    "RabbitMQ",
    "AMQP",
    "Queues",
    "Async"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "amqp://guest:guest@localhost:5672",
    "logLevel": "info",
    "param1Label": "Exchange Name",
    "param1Value": "cmox.direct",
    "param2Label": "Delivery Mode",
    "param2Value": "persistent"
  }
}