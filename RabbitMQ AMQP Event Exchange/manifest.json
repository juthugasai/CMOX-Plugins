{
  "id": "rabbitmq-exchange",
  "name": "RabbitMQ AMQP Event Exchange",
  "version": "v1.8.2",
  "category": "Connectors",
  "price": "Free",
  "author": "Community",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/rabbitmq-exchange",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/RabbitMQ%20AMQP%20Event%20Exchange",
    "openApiSpec": "https://api.cmox.io/openapi/v3/rabbitmq-exchange.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-rabbitmq-exchange",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "RabbitMQ",
    "AMQP",
    "Queues",
    "Async"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": false,
    "autoUpdate": true,
    "endpoint": "amqp://guest:guest@localhost:5672",
    "logLevel": "info",
    "param1Label": "Exchange Name",
    "param1Value": "cmox.direct",
    "param2Label": "Delivery Mode",
    "param2Value": "persistent"
  }
}