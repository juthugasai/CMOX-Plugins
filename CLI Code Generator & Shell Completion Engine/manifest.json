{
  "id": "cli-generator-zsh",
  "name": "CLI Code Generator & Shell Completion Engine",
  "version": "v1.8.0",
  "category": "Dev Tools",
  "price": "Free",
  "author": "CDUS Tech Core",
  "license": "MIT",
  "entry": "index.ts",
  "types": "types.ts",
  "verified": true,
  "engines": [
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "SQLite",
    "ClickHouse",
    "DuckDB"
  ],
  "polyglotSupport": {
    "typescript": "index.ts",
    "python": "client.py",
    "golang": "client.go",
    "rust": "client.rs",
    "java": "Client.java",
    "csharp": "Client.cs",
    "php": "client.php",
    "ruby": "client.rb",
    "cliBash": "cli.sh",
    "cliBatch": "cli.bat",
    "openApi": "openapi.json",
    "universalBridge": "bridge.ts"
  },
  "thirdPartyExtensibility": {
    "adapter": "adapter.ts",
    "webhookDispatcher": "webhook.ts",
    "integrations": "integrations.ts",
    "supportsPreIngestHooks": true,
    "supportsPostProcessHooks": true,
    "supportsCustomSinks": true,
    "jsonRpc2": true,
    "restApi": true
  },
  "docker": {
    "dockerfile": "Dockerfile",
    "compose": "docker-compose.yml",
    "kubernetes": "k8s-deployment.yaml"
  },
  "thirdPartyLinks": {
    "officialDocs": "https://docs.cmox.io/extensions/cli-generator-zsh",
    "githubRepo": "https://github.com/juthugasai/CMOX-Plugins/tree/main/CLI%20Code%20Generator%20%26%20Shell%20Completion%20Engine",
    "openApiSpec": "https://api.cmox.io/openapi/v3/cli-generator-zsh.json",
    "prometheusGrafana": "https://grafana.com/dashboards/cmox-cli-generator-zsh",
    "slackCommunity": "https://cmox.io/community/slack"
  },
  "tags": [
    "CLI",
    "Bash",
    "Zsh",
    "Terminal"
  ],
  "features": [],
  "defaultConfig": {
    "enabled": true,
    "autoUpdate": true,
    "logLevel": "info",
    "param1Label": "Target Shell",
    "param1Value": "zsh & powershell",
    "param2Label": "Install Path",
    "param2Value": "~/.cmox/bin"
  }
}